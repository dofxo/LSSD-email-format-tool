{
	"manifest_version": 3,
	"name": "LSSD Format Tool",
	"version": "1.0.0",
	"description": "Fills the topic title and post body on the LSSD government website when a post is opened from the LSSD Format Tool.",
	"key": "",
	"host_permissions": ["https://gov.eclipse-rp.net/*"],
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_title": "LSSD Format Tool",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"background": {
		"service_worker": "background.js"
	},
	"externally_connectable": {
		"matches": ["<all_urls>"]
	},
	"content_scripts": [
		{
			"matches": ["https://gov.eclipse-rp.net/*"],
			"js": ["common.js", "content.js"],
			"run_at": "document_idle",
			"all_frames": false
		}
	]
}
